# SkillBuddy production environment

SECRET_KEY=generate-a-unique-random-secret-of-at-least-50-characters
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=skillbuddy.example.com
CSRF_TRUSTED_ORIGINS=https://skillbuddy.example.com

# PostgreSQL
DATABASE_URL=postgresql://skillbuddy:change-me@db:5432/skillbuddy
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=600

# Reverse proxy / HTTPS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Single-instance persistent media fallback. Prefer S3 below in cloud deployments.
SERVE_MEDIA_FILES=True

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=use-an-app-password
EMAIL_FROM_ADDRESS=SkillBuddy <your-email@example.com>

# Optional S3-compatible media storage
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False

# AI and payments
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_IS_PRODUCTION=True

# Optional Celery workers
USE_CELERY_EMOTION_ANALYSIS=False
USE_CELERY_EMAIL_NOTIFICATIONS=False
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
