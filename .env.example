# Local development environment
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.local
ENABLE_DEBUG_TOOLBAR=False
INTERNAL_IPS=127.0.0.1

# SQLite is used by local settings. Production uses DATABASE_URL.
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_FROM_ADDRESS=your-email@example.com

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Emotions / async processing
USE_CELERY_EMOTION_ANALYSIS=False
USE_CELERY_EMAIL_NOTIFICATIONS=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=300

# Payments - Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Payments - GoPay
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_IS_PRODUCTION=False

# Optional ID prefixes
STUDENT_ID_PREFIX=ugr
LECTURER_ID_PREFIX=lec
